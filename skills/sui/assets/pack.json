      "intent": "Define the smallest useful outcome and its acceptance evidence, then progress toward it."
    },
    {
      "name": "sui-architecture",
      "intent": "Choose an architecture that meets actual constraints and remains understandable to its owners."
    },
    {
      "name": "sui-implementation",
      "intent": "Deliver the requested behavior as a small reviewable change with evidence that it works."
    },
    {
      "name": "sui-review",
      "intent": "Find defects worth fixing and explain a reachable failure with a precise code location."
    },
    {
      "name": "sui-testing",
      "intent": "Create trustworthy evidence about behavior and expose important failure modes with the smallest useful suite."
    },
    {
      "name": "sui-debugging",
      "intent": "Identify the causal failure and prove that the fix addresses it without broadening the problem."
    },
    {
      "name": "sui-delivery",
      "intent": "Make the requested change deployable with clear evidence and a recovery path."
    },
    {
      "name": "sui-reliability",
      "intent": "Protect the user-visible outcome using useful measurements, bounded failure and recovery."
    },
    {
      "name": "sui-security",
      "intent": "Reduce a concrete attack or privacy risk and verify the control at its enforcement boundary."
    },
    {
      "name": "sui-ai-systems",
      "intent": "Demonstrate useful system behavior under realistic errors rather than shipping a convincing model demo."
    },
    {
      "name": "sui-evidence",
      "intent": "Resolve the decision with traceable evidence and explicit limitations."
    },
    {
      "name": "sui-maintenance",
      "intent": "Make the next valuable change safer by building a tested model of the affected code and its consumers."
    }
